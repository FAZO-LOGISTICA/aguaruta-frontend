// scripts/locate-react-use.js
// Busca TODAS las variantes que rompen el build y muestra archivo + línea.
// ESM: import { use } from 'react' (incluye alias y saltos de línea)
// CJS: const { use } = require('react')
// También: import use from 'react' (mal uso del default)

const fs = require('fs');
const path = require('path');

const exts = new Set(['.js', '.jsx', '.ts', '.tsx', '.mjs', '.cjs']);
const ignoreDirs = new Set(['node_modules', '.git', 'build', 'dist', '.next', 'out', 'coverage']);

const root = process.cwd();
let found = [];

function walk(dir) {
  if (!fs.existsSync(dir)) return;
  for (const name of fs.readdirSync(dir)) {
    const p = path.join(dir, name);
    const st = fs.statSync(p);
    if (st.isDirectory()) {
      if (ignoreDirs.has(name)) continue;
      walk(p);
    } else if (exts.has(path.extname(p))) {
      scanFile(p);
    }
  }
}

function scanFile(file) {
  const text = fs.readFileSync(file, 'utf8');

  // Patrones a cazar:
  const patterns = [
    // import { use } from 'react'  (con alias y espacios/saltos)
    /import\s*{[^}]*\buse(\s+as\s+\w+)?\b[^}]*}\s*from\s*['"]react['"]/gi,
    // const { use } = require('react')
    /const\s*{[^}]*\buse\b[^}]*}\s*=\s*require\s*\(\s*['"]react['"]\s*\)/gi,
    // import use from 'react'
    /import\s+use\s+from\s*['"]react['"]/gi,
  ];

  const lines = text.split(/\r?\n/);
  patterns.forEach(rx => {
    let m;
    while ((m = rx.exec(text))) {
      // calcular línea aproximada
      const upto = text.slice(0, m.index);
      const line = upto.split(/\r?\n/).length;
      const context = lines.slice(Math.max(0, line - 2), line + 1).join('\n');
      found.push({ file, line, context });
    }
  });
}

walk(root);

if (!found.length) {
  console.log('✅ No se encontró ningún "use" importado desde react.');
  process.exit(0);
}

console.error('❌ Encontré importaciones inválidas de React:');
for (const f of found) {
  console.error(`- ${f.file}:${f.line}\n${f.context}\n---`);
}
process.exit(1);
